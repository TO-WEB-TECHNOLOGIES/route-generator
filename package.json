{
  "name": "osrm-bff",
  "version": "0.1.0",
  "private": true,
  "description": "Road routing for order tracking: wraps a self-hosted OSRM server for the BFF (ondc-api).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "smoke": "bash .claude/skills/bff-road-routing/scripts/smoke_test.sh",
    "osrm": "docker compose -f ops/docker-compose.yml up",
    "osrm:bg": "docker compose -f ops/docker-compose.yml up -d",
    "osrm:stop": "docker compose -f ops/docker-compose.yml down"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
