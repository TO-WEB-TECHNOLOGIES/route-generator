# Copy to .env for local dev. Every value here mirrors a default in src/config.ts.

# TEST = no token checks (local/dev). PREPROD = X-Internal-Token required everywhere, and the service
# refuses to start without INTERNAL_TOKEN. Unset = PREPROD (fails closed).
ENV=TEST

PORT=4100

# OSRM: private network only. NEVER point this at router.project-osrm.org.
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=1000

# Redis route cache (derived, disposable). Prefix keeps environments apart on a shared instance.
# 127.0.0.1, not localhost (on Windows, localhost resolves to IPv6 ::1, which Docker doesn't listen on)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=osrm-bff:dev:
REDIS_COMMAND_TIMEOUT_MS=200

# Routing tunables
REROUTE_THRESHOLD_M=30
MATCH_MIN_CONFIDENCE=0.5
MATCH_OVERLAP_POINTS=1
MATCH_MAX_POINTS=100
# Per-point /match search radius in metres (0 = OSRM default, too tight for city GPS noise)
MATCH_RADIUS_M=30

# Area the map covers: minLng,minLat,maxLng,maxLat ("none" = no check). Points outside never reach
# OSRM. Must match OSRM_BBOX in ops/osrm/prep.Dockerfile.
COVERAGE_BBOX=76.75,28.20,77.80,28.95;77.35,12.75,77.90,13.25
# Treat a route as "no route" if OSRM had to move a point further than this (m) to reach a road
MAX_SNAP_DISTANCE_M=200

# Shared secret: callers send it as X-Internal-Token. Ignored with ENV=TEST, required with ENV=PREPROD.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_TOKEN=

# Dev map page at /dev/route-viewer. Default: on with ENV=TEST, off with ENV=PREPROD.
DEV_VIEWER_ENABLED=true

# ondc-logistics-api (POST /v1/track forwards to its POST /logistics/track). Empty = /v1/track answers 503.
LOGISTICS_BASE_URL=http://127.0.0.1:3000
LOGISTICS_TIMEOUT_MS=5000
# Max time routing may hold back a track_update; after it, the update goes out with GPS fields only.
ENRICH_DEADLINE_MS=1200
# Rider trail on the logistics path is built from our own breadcrumbs (one per forwarded /on_track).
# A position closer than this (m) to the last one isn't added; keep at most N per order.
CRUMB_MIN_MOVE_M=10
CRUMBS_MAX_POINTS=120
# SSE keep-alive comment interval (keeps proxies from dropping an idle stream)
SSE_KEEPALIVE_MS=25000

# Self-ping of our own public /health so a free host doesn't put the service to sleep.
# Unset = RENDER_EXTERNAL_URL + /health on Render, off elsewhere. "none" = off.
# KEEPALIVE_URL=https://<name>.onrender.com/health
KEEPALIVE_INTERVAL_MS=600000

OSRM_BASE_URL=http://127.0.0.1:5000
ENV=TEST # Use pre-prod only when passing token in header
REDIS_URL=
LOGISTICS_BASE_URL=https://ondc-logistics.onrender.com