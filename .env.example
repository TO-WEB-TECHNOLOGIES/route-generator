# Copy to .env for local dev. Every value here mirrors a default in src/config.ts.

PORT=4100

# OSRM: private network only. NEVER point this at router.project-osrm.org.
OSRM_BASE_URL=http://osrm:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=1000

# Redis route cache (derived, disposable). Prefix keeps environments apart on a shared instance.
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=osrm-bff:dev:
REDIS_COMMAND_TIMEOUT_MS=200

# Routing tunables
REROUTE_THRESHOLD_M=30
MATCH_MIN_CONFIDENCE=0.5
MATCH_OVERLAP_POINTS=1
MATCH_MAX_POINTS=100

# Optional shared secret for /internal/* (sent as X-Internal-Token). Empty = no check.
INTERNAL_TOKEN=
